# Copy to repo-root .env. Fill secret values locally, never commit .env.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_S=8
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0
LLM_CACHE_SIZE=512
REQUEST_BUDGET_S=22
PORT=8000
LOG_LEVEL=INFO
ALLOW_NO_LLM=0
