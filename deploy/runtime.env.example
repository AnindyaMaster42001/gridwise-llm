# Copy to repo-root .env. Fill secret values locally, never commit .env.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_PROVIDER=openai_compatible
LLM_FALLBACK_MODEL=openrouter/free
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_S=8
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0
LLM_CACHE_SIZE=512
REQUEST_BUDGET_S=22
PORT=8000
LOG_LEVEL=INFO
ALLOW_NO_LLM=0
