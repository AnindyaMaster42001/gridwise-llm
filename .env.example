# Copy to .env and fill in. .env is git-ignored; never commit real values.
# These names are the ones documented in README.md for the judges.

PORT=8000
LOG_LEVEL=INFO

# ---- primary LLM provider (required: the LLM is mandatory in the note path) --
# LLM_PROVIDER: openai | groq | gemini | openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# only for openai_compatible / self-hosted endpoints
LLM_BASE_URL=

# ---- optional second provider, used when the primary fails -------------------
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# ---- budgets ----------------------------------------------------------------
LLM_TIMEOUT_S=8
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
LLM_CACHE_SIZE=512
REQUEST_BUDGET_S=22

# Offline development only. MUST be 0 (or unset) on the submitted deployment —
# the Problem Statement requires the LLM in the interpretation path.
ALLOW_NO_LLM=0
