# Copy to .env and fill in. .env is git-ignored; never commit real values.
# These names are the ones documented in README.md for the judges.

PORT=8000
LOG_LEVEL=INFO

# ---- primary LLM provider (required: the LLM is mandatory in the note path) --
# LLM_PROVIDER: openai | groq | gemini | openai_compatible
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# only for openai_compatible / self-hosted endpoints
LLM_BASE_URL=

# ---- optional second provider, used when the primary fails -------------------
LLM_FALLBACK_PROVIDER=openai_compatible
LLM_FALLBACK_MODEL=nex-agi/nex-n2.5-mini:free
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1

# ---- budgets ----------------------------------------------------------------
LLM_TIMEOUT_S=10
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0
LLM_CACHE_SIZE=512
REQUEST_BUDGET_S=25

# Offline development only. MUST be 0 (or unset) on the submitted deployment —
# the Problem Statement requires the LLM in the interpretation path.
ALLOW_NO_LLM=0
