# secrets — never commit
.env
.env.*
# `.env*` only catches files whose name STARTS with .env. A teammate handing
# over `f.env` or `prod.env` would sail straight past it into a repo that goes
# public after the deadline, so match the suffix too.
*.env
# ...but the template of NAMES (no values) must ship.
!.env.example
*.key
*.pem
secrets/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# vercel CLI link state: carries project/org ids, regenerated by `vercel link`
.vercel/

# local artifacts
.DS_Store
*.log
harness/reports/
deploy/wheels/*.whl

# Windows "downloaded file" metadata sidecars
*:Zone.Identifier
