.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache

tests/
harness/
docs/
deploy/
scripts/
*.pdf
*.md
!/README.md
Dockerfile
.dockerignore
docker-compose.yml
Makefile
pytest.ini
requirements-dev.txt
.env
.env.*
!.env.example
